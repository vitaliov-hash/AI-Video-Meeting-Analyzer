AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local speech recognition. First run downloads this multilingual model from Hugging Face.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=500
HOST=127.0.0.1
PORT=8000

# Required only when the browser UI and API are deployed on different origins.
# Comma-separated exact origins; leave blank for same-origin/local use.
CORS_ALLOWED_ORIGINS=

# Teacher Live Demo stays disabled unless deliberately activated on the local backend.
# Keep these values only in the backend's local .env; never add them to Vercel or Git.
TEACHER_DEMO_ENABLED=false
TEACHER_DEMO_PASSWORD=
TEACHER_DEMO_TOKEN_SECRET=
TEACHER_DEMO_DATA_DIR=./.teacher-demo-data
TEACHER_DEMO_DAYS=5
TEACHER_DEMO_MAX_TRANSCRIPT_CHARS=8000
